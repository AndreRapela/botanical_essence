{
  "name": "botanical-essence",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "test:coverage:shell": "ng test --watch=false --coverage --configuration=shellCoverage",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node scripts/e2e-isolated.mjs",
    "test:backend": "docker compose exec -T backend php /var/www/html/tests/run.php",
    "test:api": "node scripts/api-smoke.mjs",
    "test:backup": "node --test scripts/mysql-backup.test.mjs",
    "test:ci": "node --test scripts/ci-environment.test.mjs",
    "lint:php": "node scripts/php-lint.mjs",
    "quality": "node scripts/quality-check.mjs",
    "verify": "npm run quality && npm run lint:php && npm run test:coverage && npm run test:coverage:shell && npm run build",
    "verify:full": "npm run verify && npm run test:ci && npm run test:backend && npm run test:api && npm run test:backup"
  },
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
