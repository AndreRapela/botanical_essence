# Local development only. Keep real credentials in the ignored .env file or an approved secret store.
APP_ENV=development
APP_URL=http://localhost:4300
FRONTEND_PORT=4300
BACKEND_PORT=8180
MYSQL_PORT=3317
CORS_ALLOWED_ORIGINS=http://localhost:4300

# Replace both placeholders with separate random values of at least 32 characters.
# These example strings are intentionally rejected by the MySQL health check.
DB_DATABASE=botanical_essence
DB_USERNAME=botanical
DB_PASSWORD=replace-with-a-random-32-character-application-secret
DB_ROOT_PASSWORD=replace-with-a-different-random-32-character-root-secret

# The frontend Nginx proxy is explicitly trusted; do not add broad private network ranges.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_HOSTS=frontend

# One-click demo accounts are available only in development.
ENABLE_DEMO_ACCOUNTS=true
ALLOW_TEST_ORDER_CREATION=false
ALLOW_DISPOSABLE_DB_TESTS=false

# Development mail is written to backend/storage/mail.log, never delivered.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@botanicalessence.be
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# Safe default: local simulated checkout only. It never calls Stripe.
PAYMENT_EXECUTION_MODE=local_simulation
PAYMENT_TEST_MODE=true
PAYMENT_TEST_PRODUCT_SLUG=monstera-essencial
PAYMENT_INSTRUCTIONS=

# Leave empty until an actual Stripe test/live account and webhook endpoint are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_SETTLEMENT_CURRENCY=
STRIPE_PAYMENT_LIMITS_JSON=

# Optional encrypted backup timeout; defaults to 1 hour (allowed range: 1 second–24 hours).
# Supply MYSQL_BACKUP_DIR and MYSQL_BACKUP_KEY_HEX only at invocation via the approved secret manager.
# MYSQL_BACKUP_DUMP_TIMEOUT_MS=3600000
